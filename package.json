{
  "name": "reconlens",
  "version": "1.0.5",
  "private": true,
  "description": "Consent-first cybersecurity awareness lab for demonstrating automatic browser data and explicit browser permissions.",
  "main": "src/main/electron.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:renderer": "vite --host 0.0.0.0",
    "dev:electron": "wait-on http://localhost:5173 http://localhost:4100/health && electron .",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "esbuild src/server/runtime.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server/runtime.cjs --external:node:sqlite",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "start": "tsx src/server/index.ts",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "build": {
    "appId": "com.reconlens.desktop",
    "productName": "ReconLens",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "src/main/electron.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "app.asar.unpacked/dist"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "framer-motion": "^11.15.0",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9",
    "eslint": "^9.17.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
